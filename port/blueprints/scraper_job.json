{
  "identifier": "scraper_job",
  "title": "Scraper Job",
  "icon": "Database",
  "description": "Bright Data job. Twin needs name + size JSON.",
  "schema": {
    "properties": {
      "catalog_url": { "title": "Catalog URL", "type": "string", "format": "url" },
