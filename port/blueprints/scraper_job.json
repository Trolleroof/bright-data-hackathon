        "title": "Status",
        "type": "string",
        "enum": ["idle", "running", "ok", "broken", "repaired"],
        "default": "idle"
      },
      "object_name": { "title": "Object name", "type": "string" },
      "width_cm": { "title": "Width (cm)", "type": "number" },
      "height_cm": { "title": "Height (cm)", "type": "number" }
    },
    "required": []
  },
  "relations": {
    "run": {
      "title": "Factory run",
      "target": "factory_run",
      "required": false,
      "many": false
    }
  }
}
