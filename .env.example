# Copy to .env and fill what you have. Missing keys = that sponsor is SKIPPED, not a crash.

# --- SigNoz (Settings → Ingestion) ---
# Example endpoint: https://ingest.us.signoz.cloud:443
SIGNOZ_ENDPOINT=
SIGNOZ_INGESTION_KEY=
OTEL_SERVICE_NAME=scaletwin

# --- Port (profile → Credentials) ---
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_URL=https://api.port.io/v1

# --- Bright Data (Account Settings → API token, Scraper Studio collector id) ---
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_COLLECTOR_ID=
# Catalog page the collector will scrape. Demo contract: a water bottle.
BRIGHTDATA_CATALOG_URL=https://www.ikea.com/us/en/p/ikea-365-water-bottle-dark-gray-70478228/

# --- Twin ---
# Outer black square of the printed AprilTag, in cm. Measure after you tape it.
APRILTAG_SIZE_CM=
