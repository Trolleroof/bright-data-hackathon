# Copy to .env and fill what you have. Missing keys = that sponsor is SKIPPED, not a crash.

# --- Port (profile → Credentials) ---
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_URL=https://api.port.io/v1

# --- Bright Data (Account Settings → API token; create a SERP zone and a
# Web Unlocker zone under Proxies & Scraping — zone names, not collector ids) ---
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=
# Optional: skip search and fetch this URL directly. Leave blank for the
# happy path — search() finding the page is the point, not a fallback.
BRIGHTDATA_CATALOG_URL=

# --- Twin ---
# Outer black square of the printed AprilTag, in cm. Measure after you tape it.
# print/apriltag_36h11_id0_letter.png at 100% (no fit-to-page) is 15.3 cm.
APRILTAG_SIZE_CM=15.3

# --- Camera (optional; defaults are fine for a laptop webcam) ---
CAMERA_INDEX=0
CAMERA_FOV_DEG=60
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
# Height above the table of the red blob centroid we back-project. Half a 5 cm cube.
CUBE_TRACK_HEIGHT_CM=2.5
# Edge length of the red cube. Used to undo the visible-face bias in the blob centroid.
CUBE_SIZE_CM=5

# --- Tracing (local in-process OpenTelemetry flight recorder) ---
OTEL_SERVICE_NAME=bidex
