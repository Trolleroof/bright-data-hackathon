<mujoco model="bidex">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="2" armature="0.01"/>
    <geom condim="3" friction="0.8 0.1 0.1"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.22 0.24 0.28" rgb2="0.14 0.15 0.18"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.05"/>
    <material name="table" rgba="0.76 0.70 0.60 1"/>
    <material name="cube" rgba="0.86 0.12 0.12 1"/>
    <material name="target" rgba="0.18 0.72 0.38 0.85"/>
    <material name="tag" rgba="0.06 0.06 0.06 1"/>
    <material name="arm" rgba="0.42 0.48 0.54 1"/>
  </asset>

  <worldbody>
    <light pos="0.4 0.2 2.2" dir="-0.2 -0.1 -1" diffuse="0.85 0.85 0.85"/>
    <geom name="floor" type="plane" size="1.2 1.2 0.01" material="grid"/>

    <!-- Table 80 x 60 cm. Top face at z = 0.76. -->
    <body name="table" pos="0 0 0.74">
      <geom name="tabletop" type="box" size="0.40 0.30 0.02" material="table"/>
      <geom name="leg_fl" type="cylinder" size="0.02 0.36" pos="-0.34 -0.24 -0.38" rgba="0.35 0.3 0.26 1"/>
      <geom name="leg_fr" type="cylinder" size="0.02 0.36" pos=" 0.34 -0.24 -0.38" rgba="0.35 0.3 0.26 1"/>
      <geom name="leg_bl" type="cylinder" size="0.02 0.36" pos="-0.34  0.24 -0.38" rgba="0.35 0.3 0.26 1"/>
      <geom name="leg_br" type="cylinder" size="0.02 0.36" pos=" 0.34  0.24 -0.38" rgba="0.35 0.3 0.26 1"/>
    </body>

    <!-- AprilTag origin: back-left of the table (from you standing at -y). -->
    <site name="tag_origin" pos="-0.32 0.22 0.761" size="0.012" rgba="0.1 0.95 0.3 1"/>
    <geom name="apriltag" type="box" pos="-0.32 0.22 0.761" size="0.075 0.075 0.001" material="tag"/>

    <!-- Target pad: back-right. -->
    <geom name="target" type="box" pos="0.28 0.18 0.761" size="0.06 0.06 0.001" material="target"/>

    <body name="cube" pos="0 0 0.795">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" material="cube" mass="0.05"/>
    </body>

    <!-- Virtual arm only. No real motors. Parked at the front edge. -->
    <body name="arm_base" pos="0 -0.38 0.76">
      <geom name="arm_base" type="cylinder" size="0.035 0.02" material="arm"/>
      <body name="arm_link1" pos="0 0 0.03">
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-2.4 2.4"/>
        <geom name="arm_link1" type="capsule" fromto="0 0 0 0 0.16 0.06" size="0.016" material="arm" mass="0.2"/>
        <body name="arm_link2" pos="0 0.16 0.06">
          <joint name="elbow" type="hinge" axis="1 0 0" range="-2.0 2.0"/>
          <geom name="arm_link2" type="capsule" fromto="0 0 0 0 0.14 0.02" size="0.013" material="arm" mass="0.12"/>
          <body name="ee" pos="0 0.14 0.02">
            <joint name="wrist" type="hinge" axis="0 0 1" range="-2.0 2.0"/>
            <geom name="ee" type="box" size="0.018 0.018 0.01" rgba="0.92 0.74 0.18 1" mass="0.04"/>
            <site name="ee_tip" pos="0 0.02 0" size="0.008" rgba="1 0.4 0.1 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder_pos" joint="shoulder" kp="60" kv="8"/>
    <position name="elbow_pos" joint="elbow" kp="60" kv="8"/>
    <position name="wrist_pos" joint="wrist" kp="40" kv="6"/>
  </actuator>
</mujoco>
